# Copy this file to ".env" and fill in the two values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL — Google Maps.
# With a key, preceptors and admins can search for a place and drop a pin on a
# map inside the app while entering an address. Without one they can still use
# "I am here now" or paste a Google Maps link, so the app works either way.
# Get one at https://console.cloud.google.com -> APIs & Services -> Credentials,
# with "Maps JavaScript API", "Places API" and "Geocoding API" enabled.
# Restrict the key to your own website before going live.
VITE_GOOGLE_MAPS_API_KEY=

# OPTIONAL — pop-up notifications with the app CLOSED (Web Push).
# Pop-ups while the app is open need nothing here: the person allows
# notifications on the Notifications screen and that is that. Reaching a
# phone with the app closed needs a VAPID key pair — the public half here,
# the private half with the send-push edge function.
# Make a pair with:  npx web-push generate-vapid-keys
# Then follow supabase/functions/send-push/README.md.
VITE_VAPID_PUBLIC_KEY=
